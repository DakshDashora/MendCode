GITHUB_TOKEN = your_fallback_token_here
GOOGLE_API_KEY = your_google_api_key
GROQ_API_KEY = your_groq_api_key

# Auth Settings
JWT_SECRET_KEY = your_long_random_string_here
ENCRYPTION_KEY = your_base64_32_byte_key_here

# GitHub OAuth
GITHUB_CLIENT_ID = your_github_client_id
GITHUB_CLIENT_SECRET = your_github_client_secret
GITHUB_REDIRECT_URI = http://localhost:5173/github/callback

# Google OAuth
GOOGLE_CLIENT_ID = your_google_oauth_client_id

# Email SMTP Settings (Optional, falls back to server console logs if blank)
SMTP_HOST = smtp.gmail.com
SMTP_PORT = 587
SMTP_USER = your_smtp_username@gmail.com
SMTP_PASSWORD = your_smtp_app_password
SMTP_FROM = no-reply@mendcode.com

# Database Connection (sqlite:///./jobs.db or postgresql://...)
DATABASE_URL = sqlite:///./jobs.db